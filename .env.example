# Copy to .env and adjust. Never commit .env.
# No secrets are needed for phases 1-8. The Kaggle token lives in
# ~/.kaggle/kaggle.json (outside the repository), never here.

# Where the Delta lake, MLflow store and local outputs live.
FRAUD_DATA_DIR=./data
# Alternative config file (defaults to configs/base.yaml).
# FRAUD_CONFIG=configs/base.yaml

# Kafka API (Redpanda from docker-compose.yml).
FRAUD_KAFKA_BOOTSTRAP=localhost:19092

# MLflow. Leave empty to use a local sqlite store under $FRAUD_DATA_DIR/mlflow.
MLFLOW_TRACKING_URI=

# Spark driver memory for local runs.
FRAUD_SPARK_DRIVER_MEMORY=6g
